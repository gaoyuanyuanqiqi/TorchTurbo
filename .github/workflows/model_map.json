{
  "$schema": "CI 测试映射表：model_type -> 启动脚本 / 权重 / 端到端画像",
  "_comment": [
    "每一条的键必须与 src/torchturbo/models/<dir>/model.py 里 @register_model(...) 的",
    "名字一字不差。check_static.py 的 map 项会双向比对，漏一个当场报错。",
    "",
    "字段：",
    "  run_dir   scripts/runs 下的目录（放这套模型的启动脚本）；\"-\" = 还没有 CI 启动器",
    "  lf        llama-factory 脚本，逗号分隔，第一个是默认；\"-\" = 不支持",
    "  swift     ms-swift 脚本，同上",
    "  hf_repo   CI 下载的 HuggingFace 仓库；\"-\" = 未知（不给 train_model_path 就拒绝跑）",
    "  e2e       PR 端到端画像：",
    "              full    全量权重（train_layers=0）",
    "              trim:N  只留前 N 层（flash_trim -> model.py trim），train_layers=N",
    "              -       不参与 PR 端到端",
    "            「族内小模型优先」：已经有 tiny/2B 版的不再减层；只有 35B 这种",
    "            跑不动的才减层，否则一次 PR 要几十分钟。"
  ],
  "models": {
    "qwen3_5": {
      "run_dir": "qwen3_5_dense",
      "lf": "lf_text_sft.sh",
      "swift": "-",
      "hf_repo": "Qwen/Qwen3.5-2B",
      "e2e": "full"
    },
    "qwen3_5_moe": {
      "run_dir": "qwen3_5_moe",
      "lf": "lf_text_sft.sh",
      "swift": "swift_mllm_sft.sh,swift_text_dpo.sh",
      "hf_repo": "Qwen/Qwen3.5-35B-A3B",
      "e2e": "trim:6"
    },
    "bailing_hybrid": {
      "run_dir": "bailing_v3",
      "lf": "lf_sft.sh,lf_pt.sh,lf_dpo.sh",
      "swift": "swift_sft.sh,swift_pt.sh,swift_dpo.sh",
      "hf_repo": "inclusionAI/Ling-3.0-tiny",
      "e2e": "full"
    },
    "bailing_moe_v3_vl": {
